{
  "name": "pimpmybichon",
  "private": true,
  "version": "0.0.0",
  "description": "Atelier de customisation de voitures et de motos en 3D temps réel, sur téléphone (PWA hors ligne).",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "npm run vehicles:build && npm run maps:build",
    "dev": "vite",
    "prebuild": "npm run vehicles:build && npm run maps:build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "guard": "node tools/guard.mjs",
    "assets:check": "node tools/assets-check.mjs",
    "audio:check": "node tools/audio-check.mjs",
    "icons": "node tools/make-icons.mjs",
    "vehicles:build": "node tools/vehicles/build.mjs",
    "maps:fetch": "node tools/maps/fetch.mjs",
    "maps:build": "node tools/maps/build.mjs",
    "maps:check": "node tools/maps/check.mjs",
    "radio:pack": "node tools/radio/pack.mjs",
    "check": "npm run typecheck && npm run lint && npm run vehicles:build && npm run maps:build && npm run guard && npm run assets:check && npm run maps:check && npm run audio:check && npm run test"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/russo-one": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "idb-keyval": "6.3.0",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
