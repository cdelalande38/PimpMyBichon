# Dépendances et sorties de build
node_modules/
dist/
dev-dist/
*.tsbuildinfo

# Tests
test-results/
playwright-report/
blob-report/
coverage/
/captures/

# Dépôt privé d'assets (sons, musique, modèles sous licence) : jamais versionné ici
.private-assets/

