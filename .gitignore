# Dépendances et sorties de build
node_modules/
dist/
dev-dist/
*.tsbuildinfo

# Tests
test-results/
playwright-report/
blob-report/
coverage/
/captures/

# Dépôt privé d'assets (sons, musique, modèles sous licence) : jamais versionné ici
.private-assets/

# Sources lourdes et masters audio : hors du dépôt de l'app (§ 11 du cahier des charges)
*.blend
*.blend1
*.wav
*.flac
*.aif
*.aiff

# Environnement local
*.code-workspace
.vscode/
.idea/
.env
.env.*
!.env.example
.DS_Store
*.log

# Véhicules substituts : GLB produits par npm run vehicles:build depuis assets-src/vehicles/<id>/model.mjs.
# Le concept (modèle de banc d'essai sous licence) reste versionné.
public/assets/vehicles/*/body.glb
!public/assets/vehicles/concept/body.glb
# Roues partagées (jantes et pneus) : produites par la même commande depuis tools/vehicles/roues.mjs ;
# le catalogue public/assets/shared/wheels/catalogue.json reste versionné.
public/assets/shared/wheels/*.glb
# Pièces d'habitacle partagées (volants, pommeaux, sièges) : produites par la même commande depuis
# tools/vehicles/habitacle.mjs ; le catalogue public/assets/shared/habitacle/catalogue.json reste versionné.
public/assets/shared/habitacle/*.glb
# Le conducteur à bord : GLB produits par npm run vehicles:build depuis tools/vehicles/conducteur.mjs ;
# le catalogue public/assets/shared/conducteur/catalogue.json reste versionné.
public/assets/shared/conducteur/*.glb

# Cartes de sortie : réponses brutes des fournisseurs (assets-src/maps/<id>/brut/) et fichiers produits
# par npm run maps:build depuis assets-src/maps/<id>/donnees.json. Le manifeste map.json reste versionné.
assets-src/maps/*/brut/
public/assets/maps/*/route.json
public/assets/maps/*/apercu.json
public/assets/maps/*/chunks/
public/assets/maps/*/lointain.glb
